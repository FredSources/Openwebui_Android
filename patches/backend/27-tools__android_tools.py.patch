+def _probe_fetch_url(url: str, verify_ssl: bool = True, max_hops: int = 5):
+    """P33 — sonde HTTP légère qui renvoie (statut final, URL finale, chaîne de
+    redirections). Les redirections sont suivies saut par saut avec ré-validation
+    SSRF (validate_url) — jamais de contournement de la garde anti-SSRF."""
+    from urllib.parse import urljoin
+    from open_webui.retrieval.web.utils import (
+        WEB_LOADER_HEADERS, validate_url, get_ssrf_safe_requests_session,
+    )
+
+    chaine = [url]
+    courante = url
+    statut = 0
+    for _ in range(max_hops):
+        try:
+            validate_url(courante)
+            session = get_ssrf_safe_requests_session()
+            session.headers = WEB_LOADER_HEADERS
+            session.verify = True if verify_ssl is None else verify_ssl
+            r = session.get(courante, stream=True, timeout=30, allow_redirects=False)
+        except Exception as exc:
+            return 0, courante, chaine + [f'ERREUR: {exc}']
+        statut = r.status_code
+        loc = r.headers.get('Location')
+        r.close()
+        if statut in (301, 302, 303, 307, 308) and loc:
+            courante = urljoin(courante, loc)
+            chaine.append(courante)
+            continue
+        return statut, courante, chaine
+    return statut, courante, chaine + ['ERREUR: trop de redirections']
+
+def _pyodide_packages(code: str) -> list:
+    """P46a — paquets Pyodide à installer avant exécution. Détection par
+    simple PRÉSENCE du nom du module dans le code (import littéral, boucle,
+    importlib, littéral de chaîne — peu importe le style), pour être
+    insensible à la façon d'importer. P122 : table dressée depuis les
+    `imports` du pyodide-lock livré — les 56 wheels et leurs alias
+    (httpx, sniffio, anyio, distro, openai, pydantic, black…) sont couverts.
+    Aucune installation hors ligne non présente dans l'APK."""
+    noms = {
+        'PIL': 'pillow', 'annotated_types': 'annotated-types',
+        'annotated-types': 'annotated-types', 'anyio': 'anyio',
+        'black': 'black', 'bs4': 'beautifulsoup4', 'certifi': 'certifi',
+        'charset_normalizer': 'charset-normalizer', 'click': 'click',
+        'contourpy': 'contourpy', 'cycler': 'cycler', 'dateutil': 'python-dateutil',
+        'distro': 'distro', 'docx': 'python-docx', 'et_xmlfile': 'et-xmlfile',
+        'fitz': 'pymupdf', 'fontTools': 'fonttools', 'httpx': 'httpx',
+        'idna': 'idna', 'isympy': 'sympy', 'jiter': 'jiter', 'joblib': 'joblib',
+        'kiwisolver': 'kiwisolver', 'lxml': 'lxml', 'matplotlib': 'matplotlib',
+        'micropip': 'micropip', 'mpl_toolkits': 'matplotlib', 'mpmath': 'mpmath',
+        'mypy_extensions': 'mypy-extensions', 'mypy-extensions': 'mypy-extensions',
+        'numpy': 'numpy', 'openai': 'openai', 'openpyxl': 'openpyxl',
+        'packaging': 'packaging', 'pandas': 'pandas', 'pathspec': 'pathspec',
+        'patsy': 'patsy', 'platformdirs': 'platformdirs', 'pptx': 'python-pptx',
+        'pydantic': 'pydantic', 'pydantic_core': 'pydantic-core',
+        'pydantic-core': 'pydantic-core', 'pylab': 'matplotlib',
+        'pymupdf': 'pymupdf', 'pyparsing': 'pyparsing',
+        'python_docx': 'python-docx', 'python_pptx': 'python-pptx',
+        'pytokens': 'pytokens', 'pytz': 'pytz', 'regex': 'regex',
+        'requests': 'requests', 'scipy': 'scipy', 'seaborn': 'seaborn',
+        'six': 'six', 'sklearn': 'scikit-learn', 'sniffio': 'sniffio',
+        'soupsieve': 'soupsieve', 'statsmodels': 'statsmodels', 'sympy': 'sympy',
+        'threadpoolctl': 'threadpoolctl', 'tiktoken': 'tiktoken',
+        'tiktoken_ext': 'tiktoken', 'typing_extensions': 'typing-extensions',
+        'typing-inspection': 'typing-inspection',
+        'typing_inspection': 'typing-inspection', 'urllib3': 'urllib3',
+        'xlsxwriter': 'xlsxwriter',
+    }
+    texte = code or ''
+    import re as _re
+    trouves = set()
+    for nom, paquet in noms.items():
+        if _re.search(r'\b' + _re.escape(nom) + r'\b', texte):
+            trouves.add(paquet)
+    return sorted(trouves)
+
+async def _uploads_pour_sable(code: str = '', user_id: str = None, max_par: int = 8 * 1024 * 1024, max_total: int = 256 * 1024) -> list:
+    """P51/P77 — alignement des deux magasins : le dossier uploads de l'app est
+    injecté dans le /mnt/uploads du bac à sable (les fichiers déjà injectés y
+    PERSISTENT via IndexedDB).
+    P77 : seuls les fichiers CITÉS dans le code partent systématiquement ; les
+    petits fichiers (≤ 64 Ko, budget 256 Ko) suivent pour la découvrabilité —
+    au-delà, rien ne part : l'expédition totale faisait de CHAQUE appel un
+    transfert de mégaoctets (print('hello') mettait des secondes).
+    P120 : filtrage par utilisateur — seuls ses propres fichiers (enregistrés
+    en base avec son user_id) partent dans son bac à sable."""
+    if not user_id:
+        return []
+    from open_webui.config import UPLOAD_DIR as _UD
+    from open_webui.models.files import Files as _Files
+
+    try:
+        propres = await _Files.get_files_by_user_id(user_id)
+    except Exception:
+        return []
+    permis = {f.filename for f in propres}
+
+    texte = code or ''
+    sortie = []
+    total = 0
+    try:
+        for ent in (sorted(_UD.iterdir()) if _UD.is_dir() else []):
+            if not ent.is_file() or ent.name not in permis:
+                continue
+            taille = ent.stat().st_size
+            if taille > max_par:
+                continue
+            mentionne = ent.name in texte or ent.stem in texte
+            if not mentionne and (taille > 64 * 1024 or total + taille > max_total):
+                continue
+            sortie.append({'name': ent.name, 'data': ent.read_bytes()})
+            total += taille
+    except Exception:
+        pass
+    return sortie
+
+async def appel_avec_reprise(event_call, payload, tentatives: int = 16, pause: float = 10.0):
+    """P95 — appel événementiel avec reprise après « Client session disconnected ».
+    Cause prouvée : la WebView gelée en arrière-plan fige le heartbeat ; le
+    réaper (120 s) ferme la session et l'appel échoue alors que le code n'avait
+    même pas tourné. Au lieu d'échouer, on réessaie jusqu'au retour du client
+    (le socket se reconnecte dès que l'application revient au premier plan) ;
+    la fenêtre globale reste bornée par l'appelant (wait_for 320 s)."""
+    out = None
+    for i in range(max(1, tentatives)):
+        journal_exec_ligne("P97 event_call essai %s/%s" % (i + 1, tentatives))
+        out = await event_call(payload)
+        journal_exec_ligne("P97 essai %s -> %s" % (i + 1, (out or {}).get('error', 'ok') if isinstance(out, dict) else '?'))
+        err = out.get('error') if isinstance(out, dict) else None
+        if err and 'Client session disconnected' in err and i < tentatives - 1:
+            await asyncio.sleep(pause)
+            continue
+        break
+    if isinstance(out, dict) and out.get('error') and 'Client session disconnected' in out['error']:
+        out = {**out, 'error': (
+            'Client session disconnected — application restée en arrière-plan '
+            'trop longtemps : rouvrez l application puis relancez (le code '
+            'n a pas été exécuté).')}
+    return out
+
+def journal_exec_ligne(msg) -> None:
+    """P96 — trace d'exécution (entrée, timeout, erreur) dans exec.log.
+    Ne lève JAMAIS : le journal ne doit pas casser l'outil."""
+    try:
+        from open_webui.android_logs import journal_exec
+        journal_exec(str(msg))
+    except Exception:
+        pass
+
+
+async def remonte_fichiers_sable(output, user_id=None) -> list:
+    """P41/P108 — remontée des fichiers écrits dans /mnt/uploads : chaque
+    fichier produit est STOCKÉ via le fournisseur de stockage et ENREGISTRÉ
+    dans la base (visible au gestionnaire /fm, à display_file et à l'API
+    fichiers) — P108 : l'écriture seule sur disque laissait le fichier
+    invisible au gestionnaire. Retourne [{name, file_id}] pour chaque
+    fichier produit ; le file_id est celui de la ligne appartenant à
+    l'utilisateur courant (ACL Open WebUI). Ne lève pas sur un fichier
+    invalide."""
+    import asyncio as _aio
+    import base64 as _b64
+    import io as _io
+    import uuid as _uuid
+    from open_webui.config import UPLOAD_DIR as _UD
+    from open_webui.models.files import FileForm, Files
+    from open_webui.storage.provider import Storage
+
+    produits = []
+    if not isinstance(output, dict):
+        return produits
+    # P120 : pas de doublon en base — un fichier déjà enregistré pour cet
+    # utilisateur avec le même nom et la même taille est réutilisé (son
+    # file_id est renvoyé au modèle, qui peut l'utiliser avec display_file).
+    deja = {}
+    if user_id:
+        try:
+            deja = {
+                str((f.meta or {}).get('name') or f.filename): f
+                for f in await Files.get_files_by_user_id(user_id)
+            }
+        except Exception:
+            deja = {}
+    for _f in (output.get('files') or []):
+        try:
+            import os as _os2
+            _nom = _os2.path.basename(str(_f.get('name') or ''))
+            _don = _f.get('data')
+            if not _nom or not _don:
+                continue
+            _brut = _b64.b64decode(_don)
+            _ancien = deja.get(_nom)
+            if _ancien is not None and int((_ancien.meta or {}).get('size') or -1) == len(_brut):
+                produits.append({'name': _nom, 'file_id': _ancien.id})
+                continue
+            _dest = _UD / _nom
+            if _dest.exists() and _dest.stat().st_size == len(_brut):
+                continue  # déjà présent à l'identique (fichier d'entrée)
+            _id = str(_uuid.uuid4())
+            _tronc, _point, _ext = _nom.rpartition('.')
+            _base = ''.join(c if (c.isalnum() or c in '-_. ') else '_'
+                           for c in (_tronc or _nom))[:80] or 'fichier'
+            _stocke = f'{_id}_{_base}' + (f'.{_ext}' if _point else '')
+            _type = ('image/png' if _ext.lower() == 'png' else
+                     'image/jpeg' if _ext.lower() in ('jpg', 'jpeg') else
+                     'text/csv' if _ext.lower() == 'csv' else
+                     'application/pdf' if _ext.lower() == 'pdf' else
+                     'application/octet-stream')
+            _, _chemin = await _aio.to_thread(
+                Storage.upload_file, _io.BytesIO(_brut), _stocke,
+                {'OpenWebUI-File-Id': _id})
+            await Files.insert_new_file(
+                user_id or '',
+                FileForm(id=_id, filename=_stocke, path=_chemin, data={},
+                         meta={'name': _nom, 'content_type': _type,
+                               'size': len(_brut)}),
+            )
+            produits.append({'name': _nom, 'file_id': _id})
+        except Exception:
+            pass
+    return produits
+
+
+def journal_exec_appel(engine, response, delai_exec, stdout, stderr, fichiers_sortie, echec) -> None:
+    """P94 — journalise une exécution execute_code (statut, tailles, extrait
+    stderr sur échec) dans data/logs/exec.log (consultable/téléchargeable dans
+    /fm → Journaux). Ne lève JAMAIS : le journal ne doit pas casser l'outil."""
+    try:
+        from open_webui.android_logs import journal_exec
+        _r = "%s %s delai=%ss out=%sB err=%sB files=%s" % (
+            engine, response.get("status"), delai_exec,
+            len(stdout or ""), len(stderr or ""), len(fichiers_sortie or []))
+        if echec:
+            _r += " | " + (stderr or "").strip()[-1500:]
+        journal_exec(_r)
+    except Exception:
+        pass
+
+
+def journal_exec_exception(e) -> None:
+    """P94 — journalise une exception execute_code (nom + message)."""
+    try:
+        from open_webui.android_logs import journal_exec
+        journal_exec("EXCEPTION %s: %s" % (type(e).__name__, e))
+    except Exception:
+        pass
+
