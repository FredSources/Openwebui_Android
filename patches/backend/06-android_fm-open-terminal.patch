+    async def _fm_ot_call(method: str, chemin: str, charge: dict | None = None):
+        """Appel interne à Open Terminal : la clé ne quitte jamais le serveur."""
+        import httpx
+        from open_webui.config import DATA_DIR as _DD
+
+        cle = (_DD / 'open-terminal-api.key').read_text(encoding='utf-8').strip()
+        entetes = {
+            'Authorization': 'Bearer ' + cle,
+            'x-user-id': 'embedded',
+            'x-session-id': 'fm',
+        }
+        url = 'http://127.0.0.1:8889' + chemin
+        try:
+            async with httpx.AsyncClient(timeout=8.0, trust_env=False) as client:
+                rep = await client.request(method, url, headers=entetes, json=charge)
+            try:
+                return rep.json()
+            except Exception:
+                return {'status': 'error', 'detail': 'HTTP ' + str(rep.status_code)}
+        except Exception as exc:
+            return {'status': 'error', 'detail': str(exc)}
+
+
+    @app.post('/fm/ot/session')
+    async def fm_ot_session(user=Depends(get_verified_user)):
+        """P160 — ouvre le shell du mini-Debian via le relais local (clé serveur).
+
+        P165 — le service local peut être arrêté (bouton Service) ou ne pas
+        avoir démarré au boot. L'ouverture du shell est le premier appel de
+        l'iframe : on tente alors un démarrage à la demande, sans exposer de
+        bouton de pilotage dans le Shell root.
+        """
+        # P166 — réutiliser le shell déjà ouvert. Chaque chargement de l'iframe
+        # appelait `/api/terminals` et ouvrait un nouveau PTY ; sur appareil,
+        # `"Out of PTY devices"` apparaissait après quelques rechargements.
+        import logging as _logfm
+        _jfm = _logfm.getLogger('open_webui.android_fm')
+
+        existant = await _fm_ot_call('GET', '/api/terminals/user/output')
+        _jfm.warning('P166 ot/session : sondage sortie = %s',
+                     {k: str(v)[:80] for k, v in existant.items()})
+        if 'output' in existant:
+            _jfm.warning('P166 ot/session : réutilisation du shell existant')
+            return {'status': 'ok', 'reuse': True}
+
+        resultat = await _fm_ot_call('POST', '/api/terminals', {})
+        _jfm.warning('P166 ot/session : création = %s',
+                     {k: str(v)[:120] for k, v in resultat.items()})
+        def _indisponible(r):
+            # Un 503 du service arrêté peut n'avoir que « detail » :
+            # ne pas exiger le champ « status » pour déclencher la relance.
+            d = str(r.get('detail', '')).lower()
+            return any(m in d for m in (
+                'connecterror', 'connection refused',
+                'all connection attempts failed',
+                'connect timeout', 'service arrete',
+                'service arrêté'))
+
+        def _diagnostic(r):
+            d = str(r.get('detail', ''))
+            if ('permission denied' in d.lower()
+                    or 'errno 13' in d):
+                if 'Android/data' in d:
+                    return ('proot non exécutable : volume encore sous '
+                            'Android/data (noexec). Installez P167 ou supérieur.')
+                # P168 — le chemin est bien le volume interne. Le message
+                # P167 était trompeur : il laissait croire à un noexec externe.
+                return ('proot présent dans getFilesDir() (stockage interne) '
+                        'mais exécution refusée (errno 13). Voir la ligne P168 '
+                        'de serveur.log (mode, errno, SELinux) ; installez '
+                        'P168 ou supérieur.')
+            return d or 'shell indisponible'
+
+        # Une session ouverte contient toujours un `id`. P167 : on ne relance
+        # le service QUE sur une erreur de connexion. Une erreur applicative
+        # (proot non exécutable, PTY épuisé, HTTP 4xx) remonte immédiatement :
+        # 20 relances masquaient la vraie cause.
+        if 'id' not in resultat and _indisponible(resultat):
+            try:
+                import android_main as _am
+                _am.service_control('open_terminal', 'run')
+                for _ in range(20):
+                    await asyncio.sleep(0.25)
+                    existant = await _fm_ot_call(
+                        'GET', '/api/terminals/user/output')
+                    if 'output' in existant:
+                        return {'status': 'ok', 'reuse': True}
+                    resultat = await _fm_ot_call('POST', '/api/terminals', {})
+                    _jfm.warning('P166 ot/session : nouvel essai = %s',
+                                 {k: str(v)[:120] for k, v in resultat.items()})
+                    if 'id' in resultat:
+                        break
+            except Exception as _exc:
+                _jfm.exception('P166 ot/session : relance impossible (%s)', _exc)
+        elif 'id' not in resultat:
+            _jfm.warning('P167 ot/session : erreur applicative, pas de relance : %s',
+                         {k: str(v)[:160]
+                          for k, v in resultat.items()})
+            resultat = {'status': 'error',
+                        'detail': _diagnostic(resultat)}
+        _jfm.warning('P166/P167 ot/session : résultat final = %s',
+                     {k: str(v)[:120] for k, v in resultat.items()})
+        return resultat
+
