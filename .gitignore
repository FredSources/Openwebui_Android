# ===========================================================================
# .gitignore — OpenWebUI Android
# Principe : le dépôt contient le PROJET (sources, scripts, docs, wheels,
# wrappers). Tout ce qui est téléchargeable ou reconstruit par
# scripts/setup-env.sh est exclu — voir docs/environnement.pdf.
# ===========================================================================

# --- Environnement reconstruit par scripts/setup-env.sh ---
/android-sdk/
/tools/*
!/tools/ndk-cc/
!/tools/wrappers/
/downloads/
/vendor/*
!/vendor/open-webui/
!/vendor/searxng/
!/vendor/open-terminal
!/vendor/open-terminal/
!/vendor/proot-distro
!/vendor/proot-distro/
/.venv313/
/.venv/

# --- Caches et espaces temporaires ---
/.gradle-cache/
/.pip-cache/
/.uv-cache/
/.npm-cache/
/.xdg-cache/
/.tmp/
/.data-test/
/.data-fresh/
/.home-test/
__pycache__/
*.pyc

# --- Générés (prepare_src.py, Gradle, apply_patches.sh) ---
/src/
/src-assets/
/app/build/
/build/
/.gradle/

# --- Livrables rebuildables (jamais versionnés : limite GitHub 100 Mo/fichier) ---
/dist/
/docs/*.txt

# --- Divers ---
*.log
