+    async def _spawn_pipe_shell(session_id: str, request: Request) -> dict:
+        """P166 — repli Android : shell bash via tubes, sans /dev/ptmx.
+
+        Le PTY interactif est indisponible sur certains appareils. On conserve
+        l'exécution de commandes dans le mini-Debian via proot ; l'absence
+        d'echo et de prompt coloré est signalée dans le journal et l'interface.
+        """
+        fs = get_filesystem(request)
+        chat_id = request.headers.get("x-session-id")
+        cwd = (_get_session_cwd(chat_id, fs) if chat_id else None) or start_directory(fs.home)
+        spawn_env = sanitized_environ()
+        spawn_env.setdefault("TERM", "dumb")
+        # Indispensable sur appareil : le binaire proot embarqué charge ses
+        # bibliothèques bionic depuis OPENWEBUI_ANDROID_PROOT_LIB. Le chemin
+        # PTY applique déjà ce réglage (patch 02) ; le repli doit en faire
+        # autant, sinon le shell meurt avant d'afficher quoi que ce soit.
+        spawn_lib = os.environ.get("OPENWEBUI_ANDROID_PROOT_LIB", "")
+        if spawn_lib:
+            spawn_env["LD_LIBRARY_PATH"] = spawn_lib
+        try:
+            cmd = android_proot_prefix() + ["/bin/bash", "-i"]
+            log.warning("P166 repli pipe : cmd=%s cwd=%s LD_LIBRARY_PATH=%s",
+                        cmd, cwd, spawn_lib)
+            process = subprocess.Popen(
+                cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                stderr=subprocess.STDOUT, bufsize=0, cwd=cwd, env=spawn_env,
+                start_new_session=True,
+            )
+        except (OSError, RuntimeError) as exc:
+            # P167/P168/P169 — le binaire est dans getFilesDir() (volume interne,
+            # équivalent du $PREFIX Termux). Un « Errno 13 » ne vient donc PLUS
+            # du noexec externe : journaliser l'état réel du fichier. Le
+            # journal direct fonctionne même si le logger open_terminal n'a
+            # pas de handler fichier (piège vu sur l'appareil).
+            try:
+                _binaire = cmd[0]
+            except (NameError, IndexError, TypeError):
+                _binaire = os.environ.get("OPENWEBUI_ANDROID_PROOT", "?")
+            try:
+                _mode = oct(os.stat(_binaire).st_mode & 0o777)
+            except OSError:
+                _mode = "absent"
+            _detail = ("P167/P168/P169 exécution refusée : %s (errno=%s, mode=%s, "
+                       "X_OK=%s, racine=%s) — %s" % (
+                           _binaire, getattr(exc, "errno", "?"), _mode,
+                           os.access(_binaire, os.X_OK),
+                           "externe(noexec)" if "Android/data" in _binaire
+                           else "interne", exc))
+            log.error("%s", _detail)
+            try:
+                from open_webui import android_logs as _allog
+                _allog.journal("open_terminal", _detail, "ERROR")
+            except Exception:
+                pass
+            raise
+        return {
+            "id": session_id,
+            "created_at": _datetime.utcnow().isoformat() + "Z",
+            "pid": process.pid,
+            "backend": "pipe",
+            "process": process,
+        }
+
