+    def _fm_ico(nom: str, taille: int = 16) -> str:
+        svg = _FM_SVG
+        if taille != 16:
+            svg = svg.replace('width="16" height="16"', f'width="{taille}" height="{taille}"')
+        return svg + _FM_ICONS[nom] + '</svg>'
+
