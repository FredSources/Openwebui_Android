 from open_terminal.env import sanitized_environ
 
+# P160 — Android : les commandes et le shell interactif tournent dans le
+# mini-Debian via proot (voir docs/open-terminal-android.typ). Sans ces
+# variables, le comportement amont est strictement inchangé.
+_ANDROID_PROOT = os.environ.get("OPENWEBUI_ANDROID_PROOT", "")
+_ANDROID_ROOTFS = os.environ.get("OPENWEBUI_ANDROID_ROOTFS", "")
+_ANDROID_WORK = os.environ.get("OPENWEBUI_ANDROID_WORK", "")
+_ANDROID_LIB = os.environ.get("OPENWEBUI_ANDROID_PROOT_LIB", "")
+
+
+def android_proot_prefix() -> list[str]:
+    """Argv proot à préfixer, ou [] hors Android.
+
+    Uniquement des binds explicites : jamais -R/-S, qui lieraient $HOME et
+    donc tout DATA_DIR (base de données, secrets, clé API) dans le conteneur.
+    """
+    if not (_ANDROID_PROOT and _ANDROID_ROOTFS and _ANDROID_WORK):
+        return []
+    prefix = [
+        _ANDROID_PROOT, "-0", "-r", _ANDROID_ROOTFS,
+        "-b", "/dev", "-b", "/proc", "-b", "/sys",
+        "-b", f"{_ANDROID_WORK}:/root/work",
+        "-w", "/root/work",
+    ]
+    resolv = os.path.join(os.path.dirname(_ANDROID_WORK), "resolv.conf")
+    if os.path.isfile(resolv):
+        prefix[4:4] = ["-b", f"{resolv}:/etc/resolv.conf"]
+    return prefix
+
+
