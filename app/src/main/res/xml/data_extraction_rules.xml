<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune sauvegarde ni transfert : les données ne doivent jamais « survivre »
     à une désinstallation (règle utilisateur 2026-11-08). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
