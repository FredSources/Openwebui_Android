+def client_session_kwargs(**kwargs) -> dict:
+    """P154 : aiohttp 3.10 (épinglé sur Android) n'accepte pas `middlewares`.
+
+    Le support des middlewares côté client a été ajouté en aiohttp 3.11. Sur les
+    versions anciennes, le paramètre est simplement omis : seul le middleware
+    AWS SigV4 (`sign_aws_request`) était concerné, or Bedrock n'est pas utilisé
+    dans l'APK. Sur une version récente, le comportement amont est conservé.
+    """
+    if 'middlewares' in inspect.signature(aiohttp.ClientSession.__init__).parameters:
+        kwargs['middlewares'] = (sign_aws_request,)
+    return kwargs
+
