+    def _fm_sx_sous_onglets(actif: str = "service", etat: str = "arrêt") -> str:
+        """P155 — deux sous-onglets sous l'onglet SearXNG : Service (page
+        historique, inchangée) et Moteur de recherche (webview du moteur local)."""
+        _vert, _rouge = '#22c55e', '#ef4444'
+        dot = ('<span class="dot" style="background:'
+               + (_vert if etat == 'actif' else _rouge) + '"></span> ')
+
+        def _s(k, label, href, ic, prefix=''):
+            return (f'<a class="subtab{" on" if k == actif else ""}" href="{href}">'
+                    f'{_fm_ico(ic, 14)}{prefix}{label}</a>')
+
+        return (
+            '<div class="subtabs">'
+            + _s('service', 'Service', '/fm?folder=settings&tab=searxng&sub=service',
+                 'plug', dot)
+            + _s('engine', 'Moteur de recherche',
+                 '/fm?folder=settings&tab=searxng&sub=engine', 'search')
+            + '</div>'
+        )
