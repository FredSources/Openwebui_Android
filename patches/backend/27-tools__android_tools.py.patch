+async def compile_typst(
+    source: str = "",
+    file_path: str = "",
+    output_name: str = "",
+    __request__: Request = None,
+    __user__: dict = None,
+) -> str:
+    """Compile un document Typst (.typ) en PDF sauvegardé dans vos fichiers,
+    affichable ensuite dans la conversation.
+
+    Typst est un langage de mise en page (proche de LaTeX, plus simple).
+    Exemple minimal :
+    #set page(margin: 1.5cm)
+    = Mon document
+    Bonjour *le monde* !
+
+    :param source: texte Typst à compiler (prioritaire sur file_path)
+    :param file_path: chemin d'un fichier .typ de vos fichiers
+      (ex. files/xxxx_mon_doc.typ) si source est vide
+    :param output_name: nom du PDF (sans extension) ; par défaut celui du fichier
+    :return: JSON avec l'identifiant du PDF (outil display_file pour l'afficher)
+    """
+    try:
+        import io
+        import os
+        import shutil
+        import time
+        import uuid as uuidlib
+
+        try:
+            import typst as typst_lib
+        except Exception as _exc:
+            import os as _os
+            import sys as _sys
+            paquets = []
+            for base in list(_sys.path)[:8]:
+                try:
+                    d = _os.path.join(base, 'typst')
+                    if _os.path.isdir(d):
+                        paquets.append(d + ' -> ' + str(sorted(_os.listdir(d))[:6]))
+                except Exception:
+                    pass
+            try:
+                libre = _os.statvfs(_os.environ.get('HOME', '/')).f_bavail * 4096
+            except Exception:
+                libre = -1
+            raise RuntimeError(
+                f"import typst impossible : {_exc} | python={_sys.version.split()[0]} | "
+                f"HOM"
+                f"E={_os.environ.get('HOME', '')} | libres={libre}o | paquets={paquets}"
+            ) from _exc
+
+        # D14 (correctif accès fichiers) : UN seul cache Typst, ancré dans
+        # l'espace privé de l'app (TYPST_CACHE_DIR posé par android_main.py ;
+        # repli sur XDG_CACHE_HOME/HOME pour les tests hôte). Sans ancrage,
+        # la bibliothèque déduit son cache du contexte d'appel → paquets
+        # @preview retéléchargés, échecs intermittents hors ligne.
+        cache_root = os.environ.get("TYPST_CACHE_DIR")
+        if not cache_root:
+            cache_root = os.path.join(
+                os.environ.get("XDG_CACHE_HOME")
+                or os.path.join(os.environ.get("HOME", "/"), "cache"),
+                "typst",
+            )
+            os.environ["TYPST_CACHE_DIR"] = cache_root
+        packages_dir = os.path.join(cache_root, "packages", "preview")
+        os.makedirs(packages_dir, exist_ok=True)
+
+        # Paquets @preview EMBARQUÉS dans l'APK (extraits par MainActivity
+        # dans $HOME/typst/preview) : copiés une fois dans le cache → rendu
+        # hors ligne, sans téléchargement au premier usage.
+        bundled_dir = os.path.join(os.environ.get("HOME", ""), "typst", "preview")
+        try:
+            if os.path.isdir(bundled_dir):
+                for entry in os.listdir(bundled_dir):
+                    dest = os.path.join(packages_dir, entry)
+                    if not os.path.exists(dest):
+                        shutil.copytree(os.path.join(bundled_dir, entry), dest)
+        except OSError as bundle_exc:
+            log.warning("paquets Typst embarqués non copiés : %s", bundle_exc)
+
+        from open_webui.models.files import FileForm, Files
+        from open_webui.storage.provider import Storage
+
+        user = __user__ or {}
+
+        def _read_and_compile() -> bytes:
+            # D14 (correctif accès fichiers) : typst.compile interprète une str
+            # comme un CHEMIN, et des octets comme du source SANS contexte —
+            # les #include et images relatifs échouaient alors (« os error 2 »).
+            # Écrire TOUJOURS le .typ dans un répertoire de travail dédié puis
+            # compiler PAR CHEMIN ; le fichier est nettoyé juste après.
+            if not source and not file_path:
+                raise ValueError("Fournir 'source' (texte Typst) ou 'file_path' (fichier .typ).")
+            work = os.path.join(os.environ.get("HOME", "/"), "typst-work")
+            os.makedirs(work, exist_ok=True)
+            tmp_path = os.path.join(work, uuidlib.uuid4().hex + ".typ")
+            try:
+                data = source.encode("utf-8") if source else Storage.get_file(file_path)
+                with open(tmp_path, "wb") as fh:
+                    fh.write(data)
+                return typst_lib.compile(tmp_path)
+            finally:
+                try:
+                    os.unlink(tmp_path)
+                except OSError:
+                    pass
+
+        pdf_bytes = await asyncio.to_thread(_read_and_compile)
+
+        base = output_name
+        if not base:
+            base = file_path.rsplit("/", 1)[-1].rsplit(".", 1)[0] if file_path else "document"
+        base = "".join(c if (c.isalnum() or c in "-_. ") else "_" for c in base).strip()[:80] or "document"
+
+        file_id = str(uuidlib.uuid4())
+        filename = f"{file_id}_{base}.pdf"
+        tags = {
+            "OpenWebUI-User-Id": user.get("id", ""),
+            "OpenWebUI-User-Name": user.get("name", ""),
+            "OpenWebUI-File-Id": file_id,
+        }
+        _, stored_path = await asyncio.to_thread(Storage.upload_file, io.BytesIO(pdf_bytes), filename, tags)
+        await Files.insert_new_file(
+            user.get("id", ""),
+            FileForm(
+                id=file_id,
+                filename=filename,
+                path=stored_path,
+                data={},
+                meta={"name": f"{base}.pdf", "content_type": "application/pdf", "size": len(pdf_bytes)},
+            ),
+        )
+        return JSONCodec.dumps(
+            {
+                "file_id": file_id,
+                "filename": f"{base}.pdf",
+                "size": len(pdf_bytes),
+                "hint": "PDF généré. Utilisez l'outil display_file avec ce file_id pour l'afficher.",
+            },
+            ensure_ascii=False,
+        )
+    except Exception as exc:
+        # D14 : tracer le contexte d'accès fichier (cache, bundle, espace)
+        # pour distinguer chemin disparu / paquet manquant / disque plein.
+        try:
+            import os as _os
+            _home = _os.environ.get("HOME", "")
+            _st = _os.statvfs(_home)
+            diag = (
+                f"cache={_os.environ.get('TYPST_CACHE_DIR', '')} | "
+                f"bundle={_os.path.isdir(_os.path.join(_home, 'typst', 'preview'))} | "
+                f"libres={_st.f_bavail * _st.f_frsize}o"
+            )
+        except Exception:
+            diag = "diagnostic indisponible"
+        log.exception("compile_typst error: %s | %s", exc, diag)
+        return JSONCodec.dumps({"error": str(exc), "diagnostic": diag})
+
+async def delete_note(
+    note_id: str,
+    __request__: Request = None,
+    __user__: dict = None,
+) -> str:
+    """
+    Delete a note permanently (irreversible).
+
+    :param note_id: id of the note to delete
+    :return: JSON confirmation of the deletion
+    """
+    try:
+        from open_webui.models.notes import Notes
+
+        note = await Notes.get_note_by_id(note_id)
+        if note is None:
+            return JSONCodec.dumps({'error': f'Note introuvable : {note_id}'})
+        user = __user__ or {}
+        if user.get('role') != 'admin' and getattr(note, 'user_id', None) not in (None, user.get('id')):
+            return JSONCodec.dumps({'error': 'Accès refusé'})
+        ok = await Notes.delete_note_by_id(note_id)
+        return JSONCodec.dumps(
+            {'status': 'supprimée' if ok else 'erreur', 'id': note_id}, ensure_ascii=False)
+    except Exception as e:
+        log.exception(f'delete_note error: {e}')
+        return JSONCodec.dumps({'error': str(e)})
+
