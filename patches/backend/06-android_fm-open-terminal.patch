+    async def _fm_ot_call(method: str, chemin: str, charge: dict | None = None):
+        """Appel interne à Open Terminal : la clé ne quitte jamais le serveur."""
+        import httpx
+        from open_webui.config import DATA_DIR as _DD
+
+        cle = (_DD / 'open-terminal-api.key').read_text(encoding='utf-8').strip()
+        entetes = {
+            'Authorization': 'Bearer ' + cle,
+            'x-user-id': 'embedded',
+            'x-session-id': 'fm',
+        }
+        url = 'http://127.0.0.1:8889' + chemin
+        try:
+            async with httpx.AsyncClient(timeout=8.0, trust_env=False) as client:
+                rep = await client.request(method, url, headers=entetes, json=charge)
+            try:
+                return rep.json()
+            except Exception:
+                return {'status': 'error', 'detail': 'HTTP ' + str(rep.status_code)}
+        except Exception as exc:
+            return {'status': 'error', 'detail': str(exc)}
+
+
+    @app.post('/fm/ot/session')
+    async def fm_ot_session(user=Depends(get_verified_user)):
+        """P160 — ouvre le shell du mini-Debian via le relais local (clé serveur)."""
+        return await _fm_ot_call('POST', '/api/terminals', {})
+
+
+    @app.get('/fm/ot/output')
+    async def fm_ot_output(user=Depends(get_verified_user)):
+        """P162 — lit la sortie du shell (jamais la clé API côté navigateur)."""
+        return await _fm_ot_call('GET', '/api/terminals/user/output')
+
+
+    @app.post('/fm/ot/input')
+    async def fm_ot_input(request: Request, user=Depends(get_verified_user)):
+        """P162 — relaie la saisie xterm.js vers le PTY du service local."""
+        try:
+            corps = await request.json()
+        except Exception:
+            corps = {}
+        return await _fm_ot_call('POST', '/api/terminals/user/input',
+                                 {'input': str(corps.get('input', ''))})
+
+
+    @app.post('/fm/ot/resize')
+    async def fm_ot_resize(request: Request, user=Depends(get_verified_user)):
+        """P162 — ajuste la taille du PTY à celle du conteneur xterm.js."""
+        try:
+            corps = await request.json()
+        except Exception:
+            corps = {}
+        return await _fm_ot_call('POST', '/api/terminals/user/resize',
+                                 {'rows': corps.get('rows', 24),
+                                  'cols': corps.get('cols', 80)})
+
+
+    @app.post('/fm/ot/reset')
+    async def fm_ot_reset(request: Request, user=Depends(get_verified_user)):
+        """P163 — programme la reconstruction du conteneur proot au redémarrage."""
+        forme = await request.form()
+        mode = 'wipe-work' if forme.get('mode') == 'wipe-work' else 'environment'
+        try:
+            from open_webui.config import DATA_DIR as _DD
+            (_DD / 'open-terminal-reset-requested').write_text(mode, encoding='utf-8')
+        except Exception as exc:
+            return {'status': 'error', 'detail': str(exc)}
+        return {'status': 'ok', 'mode': mode}
+
