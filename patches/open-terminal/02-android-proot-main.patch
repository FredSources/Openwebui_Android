+    @app.post("/api/terminals/user/resize", operation_id="resize_user_terminal", dependencies=[Depends(verify_api_key)])
+    async def resize_user_terminal(request: Request, body: dict):
+        """P162 — resize the active user shell from the xterm.js FitAddon."""
+        session = _user_terminal(request)
+        try:
+            rows = max(1, min(200, int(body.get("rows", 24))))
+            cols = max(1, min(400, int(body.get("cols", 80))))
+        except (TypeError, ValueError):
+            raise HTTPException(status_code=400, detail="Invalid rows/cols")
+        try:
+            if session["backend"] == "pty":
+                fcntl.ioctl(
+                    session["master_fd"], termios.TIOCSWINSZ,
+                    struct.pack("HHHH", rows, cols, 0, 0),
+                )
+            else:
+                session["pty_process"].setwinsize(rows, cols)
+        except Exception as exc:
+            raise HTTPException(status_code=409, detail=f"resize impossible : {exc}")
+        return {"status": "ok", "rows": rows, "cols": cols}
